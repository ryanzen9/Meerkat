{
  "name": "vscode-review-bot",
  "displayName": "Review Bot",
  "version": "0.1.0",
  "description": "AI-powered code review and chat in a dedicated Review Bot sidebar.",
  "categories": [
    "Other",
    "SCM Providers"
  ],
  "keywords": [
    "react",
    "review",
    "scm",
    "webview"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ryanzen9/vscode-review-bot.git"
  },
  "publisher": "local-dev",
  "workspaces": [
    "webview"
  ],
  "type": "module",
  "main": "./dist/extension/extension.cjs",
  "scripts": {
    "bridge:smoke": "bun scripts/bridge-smoke.ts",
    "build": "bun run lint && bun run typecheck && bun run build:extension && bun run build:webview",
    "build:extension": "vite build",
    "build:webview": "bun run --cwd webview build",
    "dev": "bun run scripts/watch.ts",
    "watch": "bun run dev",
    "typecheck": "tsc -p tsconfig.extension.json && tsc -p tsconfig.tools.json && bun run --cwd webview typecheck",
    "typecheck:watch": "bun run --parallel typecheck:host:watch typecheck:webview:watch",
    "test": "bun test && bun run --cwd webview test",
    "lint": "oxlint --deny-warnings .",
    "lint:fix": "oxlint --fix --deny-warnings .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "check": "bun run lint && bun run format:check && bun run typecheck && bun run test",
    "vscode:prepublish": "bun run build",
    "package": "bun run scripts/package.ts",
    "clean": "bun run scripts/clean.ts",
    "typecheck:host:watch": "tsc -p tsconfig.json --watch",
    "typecheck:webview:watch": "bun run --cwd webview typecheck:watch"
  },
  "dependencies": {
    "@ai-sdk/openai": "4.0.94",
    "ai": "7.0.141",
    "eventsource-parser": "3.1.1",
    "jose": "6.2.12",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/bun": "1.3.13",
    "@types/node": "20.19.43",
    "@types/vscode": "1.96.0",
    "@vscode/vsce": "4.0.0",
    "oxfmt": "0.72.0",
    "oxlint": "1.87.0",
    "typescript": "5.9.3",
    "vite": "8.3.4"
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "reviewBot",
          "title": "Review Bot",
          "icon": "resources/meerkat.svg"
        }
      ]
    },
    "views": {
      "reviewBot": [
        {
          "type": "webview",
          "id": "reviewBot.panel",
          "name": "Review Bot",
          "contextualTitle": "Review Bot",
          "icon": "resources/meerkat.svg",
          "visibility": "visible"
        }
      ]
    },
    "commands": [
      {
        "command": "reviewBot.chatgptSignIn",
        "title": "Continue with ChatGPT",
        "category": "Review Bot"
      },
      {
        "command": "reviewBot.bridgeConnection",
        "title": "Export Bridge Connection for API Testing",
        "category": "Review Bot"
      },
      {
        "command": "reviewBot.showPanel",
        "title": "Open Panel",
        "category": "Review Bot"
      },
      {
        "command": "reviewBot.refresh",
        "title": "Refresh Workspace",
        "category": "Review Bot",
        "icon": "$(refresh)"
      },
      {
        "command": "reviewBot.reloadWebview",
        "title": "Reload Webview",
        "category": "Review Bot",
        "icon": "$(debug-restart)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "reviewBot.refresh",
          "when": "view == reviewBot.panel",
          "group": "navigation@1"
        },
        {
          "command": "reviewBot.reloadWebview",
          "when": "view == reviewBot.panel",
          "group": "navigation@2"
        }
      ]
    },
    "configuration": {
      "title": "Review Bot",
      "properties": {
        "reviewBot.greeting": {
          "type": "string",
          "default": "你好，来自 Extension Host！",
          "maxLength": 500,
          "description": "示例通信按钮返回的问候语。",
          "scope": "window"
        },
        "reviewBot.showWorkspacePaths": {
          "type": "boolean",
          "default": true,
          "description": "在面板中显示工作区路径。",
          "scope": "window"
        }
      }
    }
  },
  "extensionKind": [
    "workspace"
  ],
  "engines": {
    "bun": ">=1.3.13",
    "node": ">=22.12.0",
    "vscode": "^1.96.0"
  },
  "packageManager": "bun@1.3.13",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    },
    "virtualWorkspaces": true
  }
}
