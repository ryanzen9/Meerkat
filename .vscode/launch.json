{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Meerkat Extension",
      "type": "extensionHost",
      "request": "launch",
      "runtimeExecutable": "${execPath}",
      "args": ["--extensionDevelopmentPath=${workspaceFolder}"],
      "outFiles": ["${workspaceFolder}/dist/extension/**/*.cjs"],
      "sourceMaps": true,
      "preLaunchTask": "dev",
      "resolveSourceMapLocations": ["${workspaceFolder}/**", "!**/node_modules/**"]
    }
  ]
}
